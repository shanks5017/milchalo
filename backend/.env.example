# Environment variables for RouteStitch Core API
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
# Port for this service. Default: 3002
# (train/ uses 3000; avoid conflicts with frontend dev servers on 3000/5173)
PORT=3002

# ── Supabase ─────────────────────────────────────────────────────────────────
# Used by historyLogger (coming from train module) and future analytics.
# If absent, history logging silently no-ops; live endpoints continue normally.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-service-role-key

# ── External API Keys ─────────────────────────────────────────────────────────
# RailKit (or equivalent IRCTC data provider) for train availability checks
RAILKIT_API_KEY=your-railkit-api-key-here

# Groq (LLM inference) — for future NLP query parsing / route explanation
GROQ_API_KEY=your-groq-api-key-here

# ── Sibling Services ──────────────────────────────────────────────────────────
# URL of the Python bus scraper service (bus/ directory exposed via FastAPI/Flask)
# This service does not exist yet; URL is a placeholder for when it is built.
BUS_SERVICE_URL=http://localhost:8000

# ── Node env ──────────────────────────────────────────────────────────────────
# Set to "production" to suppress internal error details from API responses
NODE_ENV=development
